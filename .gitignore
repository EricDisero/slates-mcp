# Dependencies
node_modules/

# Build output
packages/*/dist/
packages/*/tsconfig.tsbuildinfo
packages/mcp/dist-mcpb/

# The retired skills-pack zips (no longer built since 2026-11-17: the pack is served by the brain).
dist-pack/
dist-plugins/

# Generated (by packages/shared/scripts/embed-skills.mjs on every build)
packages/shared/src/skills/content.ts
packages/shared/src/skills/hyperframes-content.ts

# Generated (by packages/shared/scripts/sync-partials.mjs on every build).
# NOTE: the RESOLVED text inside the @inject markers in skills/*.md IS
# committed on purpose — skills/ is a published artifact that install-skills
# writes verbatim to users' disks, and committing it makes every de-fork
# visible in review. Only this TS mirror is generated.
packages/shared/src/prompts/partials.generated.ts

# Local env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Misc
.cache/
coverage/

# --- Secrets: never commit (standard block) ---
.env
.env.*
!.env.example
!.env.sample
*.pem
*.p12
*.pfx
credentials.json
client_secret*.json
service-account*.json
token*.json

# Codex: machine-local. Codex imports .claude/settings.json hooks into .codex/ on
# first open; the blank .codex/hooks.json stops that. The real Codex hook is the
# global adapter (second-brain/rules/agent-runtime.md).
/.codex/

# guard-claude-md.py keeps the CLAUDE.md word count it last saw here, per machine.
.claude/hooks/.claude-md-words

# Exports built from the private brain (slates-api brain/, license tier): never in this public repo or the npm
# package. scripts/brain-leak-check.mjs and each builder's --check hold the line.
packages/shared/exports/slates-prompt-builder/generated/
packages/shared/exports/slates-chatgpt-images/generated/

# Eval traces quote the playbooks a session read, and the brain is private (slates-api brain/): they stay on the
# machine that ran them. The scored files (scores.json, craft.json, report.md, the routing JSON) are committed. The
# traces tracked before 2026-10-25 predate the move and stay as they were.
scripts/behaviour-ab/results/*/traces/
scripts/brain-eval/results/*/traces/
