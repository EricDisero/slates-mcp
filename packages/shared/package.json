{
  "name": "@slatesvideo/shared",
  "version": "0.6.11",
  "description": "Shared operations layer for the Slates MCP server and CLI: auth, cloud/desktop clients, and the single tool surface both consume. Most users want @slatesvideo/mcp-server or @slatesvideo/cli instead.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auth": "./dist/auth.js",
    "./clients/cloud": "./dist/clients/cloud.js",
    "./clients/desktop": "./dist/clients/desktop.js",
    "./operations": "./dist/operations/index.js",
    "./prompts": {
      "import": "./dist/prompts/index.js",
      "types": "./dist/prompts/index.d.ts"
    },
    "./model-capabilities": {
      "types": "./dist/prompts/model-capabilities.d.ts",
      "default": "./dist/prompts/model-capabilities.js"
    },
    "./shot-grammar": {
      "types": "./dist/prompts/shot-grammar.d.ts",
      "default": "./dist/prompts/shot-grammar.js"
    },
    "./asset-label": {
      "types": "./dist/prompts/asset-label.d.ts",
      "default": "./dist/prompts/asset-label.js"
    },
    "./model-facts": {
      "types": "./dist/prompts/model-facts.d.ts",
      "default": "./dist/prompts/model-facts.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "exports/slates-prompt-builder/generated",
    "exports/slates-chatgpt-images/generated",
    "README.md"
  ],
  "scripts": {
    "sync-partials": "node scripts/sync-partials.mjs",
    "build-prompt-builder": "node scripts/build-prompt-builder.mjs",
    "check-prompt-builder": "node scripts/build-prompt-builder.mjs --check",
    "build-chatgpt-skill": "node scripts/build-chatgpt-skill.mjs",
    "build": "node scripts/build-chatgpt-skill.mjs --check && node scripts/sync-partials.mjs --check && node scripts/build-prompt-builder.mjs --check && node scripts/embed-skills.mjs && tsc && node scripts/render-capability-partials.mjs --check && node scripts/update-check-check.mjs",
    "typecheck": "node scripts/sync-partials.mjs --check && node scripts/build-prompt-builder.mjs --check && node scripts/embed-skills.mjs && tsc --noEmit",
    "prepublishOnly": "npm run build && node ../../scripts/cinematic-catalogue-check.mjs && node ../../scripts/prompt-control-check.mjs",
    "render-partials": "node scripts/render-capability-partials.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricDisero/slates-mcp.git",
    "directory": "packages/shared"
  },
  "homepage": "https://slates.video",
  "bugs": {
    "url": "https://github.com/EricDisero/slates-mcp/issues"
  },
  "keywords": [
    "slates",
    "mcp",
    "model-context-protocol",
    "ai-video",
    "video-generation",
    "image-generation",
    "claude",
    "veo",
    "kling",
    "seedance"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "^5.7.0"
  }
}
