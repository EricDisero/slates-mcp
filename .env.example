# Slates MCP monorepo. Nothing here is required: the CLI stores the user's token
# under its own config dir after `slates login`. `node scripts/env-example-check.mjs`
# keeps this file and the code in lockstep.

# Point the CLI at a non-production API (packages/cli/src/commands/login.ts).
# SLATES_CLOUD_BASE_URL=https://slates-api.fly.dev
# Version stamp for the skills pack build (scripts/build-skills-pack.mjs).
# PACK_VERSION=
