# Slates MCP monorepo. Nothing here is required: the CLI stores the user's token
# under its own config dir after `slates login`. `node scripts/env-example-check.mjs`
# keeps this file and the code in lockstep.

# Point the CLI at a non-production API (packages/cli/src/commands/login.ts).
# SLATES_CLOUD_BASE_URL=https://slates-api.fly.dev
# Version stamp for the skills pack build (scripts/build-skills-pack.mjs).
# PACK_VERSION=
# Where the paid pack skills live (scripts/build-skills-pack.mjs). Default: the
# sibling repo, ../slates-api/pack-skills.
# SLATES_PACK_SKILLS_DIR=

# The slate checkout the build's desktop checks read (scripts/desktop-source.mjs),
# absolute or relative to this repo. Required in a worktree; default ../slate.
# SLATES_DESKTOP_DIR=

# Overrides slates-web's docs pin (slates-web/scripts/llm-docs/desktop-docs-ref.json) for the
# manual check (scripts/app-manual-check.mjs). Empty means slate's checkout.
# SLATES_DOCS_REF=

# Optional Codex configuration directory for read-only MCP diagnostics.
# CODEX_HOME=

# The Claude Code executable the behaviour A/B spawns (scripts/behaviour-ab/run.mjs,
# score.mjs). Default: `claude` on PATH.
# CLAUDE_BIN=

# The folder of the user's own brain, read beside the bundled skills (packages/shared/src/skills/my-brain.ts).
# Default: ~/.slates/my-brain.
# SLATES_MY_BRAIN_DIR=
